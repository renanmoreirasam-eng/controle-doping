// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String   @id @default(cuid())
  name     String
  email    String   @unique
  password String
  role     UserRole @default(OFFICIAL)

  official Official?

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  pushSubscriptions PushSubscription[]

  announcementAcknowledgements AnnouncementAcknowledgement[]

  adminTasksCreated AdminTask[] @relation("AdminTaskCreator")

  @@index([role])
  @@index([createdAt])
}

model Official {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  phone  String?
  pixKey String?

  documentType          String?
  documentNumber        String?
  cpf                   String?
  birthDate             DateTime?
  address               String?
  shirtSize             String?
  operationalRole       String?
  personalDataUpdatedAt DateTime?

  kits             Kit[]
  kitMovementsFrom KitMovement[] @relation("KitMovementFromOfficial")
  kitMovementsTo   KitMovement[] @relation("KitMovementToOfficial")
  matchKits        MatchKit[]

  active Boolean @default(true)

  scales MatchOfficial[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([operationalRole])
  @@index([createdAt])
}

model Championship {
  id String @id @default(cuid())

  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matches Match[]

  @@index([name])
}

model Stadium {
  id String @id @default(cuid())

  name      String
  city      String
  state     String
  address   String?
  cep       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matches Match[]

  @@index([city])
  @@index([state])
  @@index([city, state])
}

model Team {
  id        String   @id @default(cuid())
  name      String
  shortName String?
  cnpj      String?
  city      String
  state     String
  category  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, state])
  @@index([isActive])
  @@index([city])
  @@index([state])
}

model Match {
  id String @id @default(cuid())

  championshipId String
  championship   Championship @relation(fields: [championshipId], references: [id])

  stadiumId String
  stadium   Stadium @relation(fields: [stadiumId], references: [id])

  homeTeam    String
  awayTeam    String
  missionCode String?

  matchNumber          String?
  roundOrPhase         String?
  missionOrderFileName String?
  missionOrderFileType String?
  missionOrderFileData String? @db.Text

  athleteListFileName String?
  athleteListFileType String?
  athleteListFileData String? @db.Text

  finalDocumentFileName String?
  finalDocumentFileType String?
  finalDocumentFileData String? @db.Text

  matchDate DateTime

  status MatchStatus @default(SCHEDULED)

  officials MatchOfficial[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  draws           Draw[]
  substitutions   Substitution[]
  roomInspections RoomInspection[]
  operationalLogs MatchOperationalLog[]

  kits         MatchKit[]
  kitMovements KitMovement[]

  @@index([status])
  @@index([matchDate])
  @@index([status, matchDate])
  @@index([championshipId])
  @@index([stadiumId])
  @@index([createdAt])
  @@index([updatedAt])
}

enum KitStatus {
  DISPONIVEL
  COM_DCO
  VINCULADO_JOGO
  UTILIZADO
  ENVIADO_LABORATORIO
  CANCELADO
}

enum KitMovementType {
  ENTRADA_ESTOQUE
  REPASSE_DCO
  VINCULO_JOGO
  UTILIZADO
  ENVIADO_LABORATORIO
  CANCELADO
  DEVOLUCAO_ESTOQUE
}

model Kit {
  id String @id @default(cuid())

  number String    @unique
  status KitStatus @default(DISPONIVEL)

  currentOfficialId String?
  currentOfficial   Official? @relation(fields: [currentOfficialId], references: [id])

  matchKits MatchKit[]
  movements KitMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([currentOfficialId])
  @@index([status, currentOfficialId])
  @@index([createdAt])
  @@index([updatedAt])
}

model MatchKit {
  id String @id @default(cuid())

  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  kitId String
  kit   Kit    @relation(fields: [kitId], references: [id])

  officialId String
  official   Official @relation(fields: [officialId], references: [id])

  createdAt DateTime  @default(now())
  usedAt    DateTime?

  @@unique([matchId, kitId])
  @@index([matchId])
  @@index([kitId])
  @@index([officialId])
  @@index([matchId, officialId])
  @@index([usedAt])
  @@index([createdAt])
}

model KitMovement {
  id String @id @default(cuid())

  kitId String
  kit   Kit    @relation(fields: [kitId], references: [id], onDelete: Cascade)

  type KitMovementType

  fromOfficialId String?
  fromOfficial   Official? @relation("KitMovementFromOfficial", fields: [fromOfficialId], references: [id])

  toOfficialId String?
  toOfficial   Official? @relation("KitMovementToOfficial", fields: [toOfficialId], references: [id])

  matchId String?
  match   Match?  @relation(fields: [matchId], references: [id])

  userId    String?
  userName  String?
  userEmail String?

  notes String?

  createdAt DateTime @default(now())

  @@index([kitId])
  @@index([type])
  @@index([matchId])
  @@index([fromOfficialId])
  @@index([toOfficialId])
  @@index([createdAt])
  @@index([kitId, createdAt])
}

model MatchOfficial {
  id String @id @default(cuid())

  matchId String
  match   Match  @relation(fields: [matchId], references: [id])

  officialId String
  official   Official @relation(fields: [officialId], references: [id])

  role OfficialRole

  confirmed Boolean?

  createdAt DateTime @default(now())

  @@index([matchId])
  @@index([officialId])
  @@index([confirmed])
  @@index([matchId, role])
  @@index([officialId, confirmed])
  @@index([createdAt])
}

enum UserRole {
  ADMIN
  COORDINATOR
  OFFICIAL
}

enum MatchStatus {
  SCHEDULED
  SCALE_ACCEPTED
  IN_PROGRESS
  CONTROL_DONE
  CANCELED
}

enum OfficialRole {
  DCO
  ASSISTANT
}

model Draw {
  id String @id @default(cuid())

  matchId String
  match   Match  @relation(fields: [matchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  players DrawPlayer[]

  @@index([matchId])
  @@index([createdAt])
}

model DrawPlayer {
  id String @id @default(cuid())

  drawId String
  draw   Draw   @relation(fields: [drawId], references: [id])

  team     String
  name     String
  number   String
  nickname String?
  type     DrawPlayerType

  createdAt DateTime @default(now())

  @@index([drawId])
  @@index([type])
  @@index([team])
}

enum DrawPlayerType {
  EXAME
  RESERVA
}

model Substitution {
  id String @id @default(cuid())

  matchId String
  match   Match  @relation(fields: [matchId], references: [id])

  team            String
  playerOutName   String
  playerOutNumber String
  playerInName    String
  playerInNumber  String
  minute          Int?
  period          String?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([matchId])
  @@index([createdAt])
}

model RoomInspection {
  id String @id @default(cuid())

  matchId String
  match   Match  @relation(fields: [matchId], references: [id])

  status String  @default("PENDING")
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items  RoomInspectionItem[]
  photos RoomInspectionPhoto[]

  @@index([matchId])
  @@index([status])
  @@index([createdAt])
}

model RoomInspectionItem {
  id String @id @default(cuid())

  inspectionId String
  inspection   RoomInspection @relation(fields: [inspectionId], references: [id])

  label  String
  status String
  notes  String?

  @@index([inspectionId])
  @@index([status])
}

model RoomInspectionPhoto {
  id String @id @default(cuid())

  inspectionId String
  inspection   RoomInspection @relation(fields: [inspectionId], references: [id])

  fileName String
  dataUrl  String @db.Text

  createdAt DateTime @default(now())

  @@index([inspectionId])
  @@index([createdAt])
}

model MatchOperationalLog {
  id String @id @default(cuid())

  matchId String
  match   Match  @relation(fields: [matchId], references: [id])

  userId    String?
  userName  String?
  userEmail String?

  step OperationalStep

  latitude  Float?
  longitude Float?
  comment   String? @db.Text

  createdAt DateTime @default(now())

  @@index([matchId])
  @@index([step])
  @@index([createdAt])
  @@index([matchId, step])
}

enum OperationalStep {
  CHECKIN_STADIUM
  MATCH_IN_PROGRESS
  DRAW_DONE
  CONTROL_DONE
}

model PushSubscription {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint String @unique
  p256dh   String
  auth     String

  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
}

model Announcement {
  id String @id @default(cuid())

  title      String
  message    String                 @db.Text
  targetRole AnnouncementTargetRole

  active Boolean @default(true)

  createdByUserId String?
  createdByName   String?
  createdByEmail  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  acknowledgements AnnouncementAcknowledgement[]

  @@index([active])
  @@index([targetRole])
  @@index([createdAt])
}

model AnnouncementAcknowledgement {
  id String @id @default(cuid())

  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  acknowledgedAt DateTime @default(now())

  @@unique([announcementId, userId])
  @@index([userId])
  @@index([acknowledgedAt])
}

enum AnnouncementTargetRole {
  ALL
  COORDINATOR
  OFFICIAL
}

model AdminTask {
  id String @id @default(cuid())

  title       String
  description String? @db.Text

  dueDate  DateTime
  remindAt DateTime?

  done   Boolean   @default(false)
  doneAt DateTime?

  createdByUserId String?
  createdBy        User?   @relation("AdminTaskCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByName    String?
  createdByEmail   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dueDate])
  @@index([done])
  @@index([done, dueDate])
  @@index([createdByUserId])
}
